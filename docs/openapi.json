 "components": {
  "schemas": {
   "AskIn": {
    "properties": {
     "question": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1,
      "title": "Question"
     },
     "as_of": {
      "anyOf": [
       {
        "type": "string",
        "format": "date"
       },
       {
        "type": "null"
       }
      ],
      "title": "As Of"
     },
     "method": {
      "type": "string",
      "enum": [
       "bm25",
       "dense",
       "hybrid",
       "rerank"
      ],
      "title": "Method",
      "default": "hybrid"
     },
     "collection": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 64
       },
       {
        "type": "null"
       }
      ],
      "title": "Collection"
     },
     "include_history": {
      "type": "boolean",
      "title": "Include History",
      "default": false
     },
     "generate": {
      "type": "string",
      "enum": [
       "extractive",
       "generative",
       "lmstudio",
       "ollama"
      ],
      "title": "Generate",
      "default": "extractive"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "question"
    ],
    "title": "AskIn"
   },
   "DecisionIn": {
    "properties": {
     "decision": {
      "type": "string",
      "enum": [
       "approve",
       "reject"
      ],
      "title": "Decision"
     },
     "note": {
      "type": "string",
      "maxLength": 600,
      "title": "Note",
      "default": ""
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "decision"
    ],
    "title": "DecisionIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "IngestIn": {
    "properties": {
     "filename": {
      "type": "string",
      "maxLength": 300,
      "title": "Filename"
     },
     "content_base64": {
      "type": "string",
      "title": "Content Base64"
     },
     "doc_key": {
      "type": "string",
      "maxLength": 64,
      "title": "Doc Key"
     },
     "title": {
      "type": "string",
      "maxLength": 300,
      "title": "Title"
     },
     "collection": {
      "type": "string",
      "maxLength": 64,
      "title": "Collection"
     },
     "doc_type": {
      "type": "string",
      "maxLength": 32,
      "title": "Doc Type",
      "default": "memo"
     },
     "classification": {
      "type": "string",
      "enum": [
       "public",
       "internal",
       "confidential",
       "restricted"
      ],
      "title": "Classification",
      "default": "confidential"
     },
     "acl_groups": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 8,
      "minItems": 1,
      "title": "Acl Groups"
     },
     "effective_date": {
      "type": "string",
      "format": "date",
      "title": "Effective Date"
     },
     "retention": {
      "type": "string",
      "maxLength": 120,
      "title": "Retention",
      "default": "7y"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "filename",
     "content_base64",
     "doc_key",
     "title",
     "collection",
     "acl_groups",
     "effective_date"
    ],
    "title": "IngestIn"
   },
   "LoginIn": {
    "properties": {
     "username": {
      "type": "string",
      "maxLength": 64,
      "title": "Username"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "username"
    ],
    "title": "LoginIn"
   },
   "ReviewIn": {
    "properties": {
     "request_id": {
      "type": "string",
      "maxLength": 40,
      "title": "Request Id"
     },
     "question": {
      "type": "string",
      "maxLength": 500,
      "title": "Question"
     },
     "answer_mode": {
      "type": "string",
      "enum": [
       "extractive",
       "generative"
      ],
      "title": "Answer Mode"
     },
     "sentence": {
      "type": "string",
      "maxLength": 2000,
      "title": "Sentence"
     },
     "version_id": {
      "type": "integer",
      "title": "Version Id"
     },
     "char_start": {
      "type": "integer",
      "title": "Char Start"
     },
     "char_end": {
      "type": "integer",
      "title": "Char End"
     },
     "quote": {
      "type": "string",
      "maxLength": 4000,
      "title": "Quote"
     },
     "verdict": {
      "type": "string",
      "enum": [
       "correct",
       "incorrect",
       "partial"
      ],
      "title": "Verdict"
     },
     "reason": {
      "type": "string",
      "maxLength": 600,
      "title": "Reason",
      "default": ""
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "request_id",
     "question",
     "answer_mode",
     "sentence",
     "version_id",
     "char_start",
     "char_end",
     "quote",
     "verdict"
    ],
    "title": "ReviewIn"
   },
   "SummaryIn": {
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "title": "Title"
     },
     "question": {
      "type": "string",
      "maxLength": 500,
      "title": "Question",
      "default": ""
     },
     "recipient": {
      "type": "string",
      "maxLength": 200,
      "title": "Recipient",
      "default": ""
     },
     "items": {
      "items": {
       "$ref": "#/components/schemas/SummaryItem"
      },
      "type": "array",
      "maxItems": 20,
      "minItems": 1,
      "title": "Items"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "title",
     "items"
    ],
    "title": "SummaryIn"
   },
   "SummaryItem": {
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 2000,
      "title": "Text"
     },
     "version_id": {
      "type": "integer",
      "title": "Version Id"
     },
     "char_start": {
      "type": "integer",
      "title": "Char Start"
     },
     "char_end": {
      "type": "integer",
      "title": "Char End"
     },
     "quote": {
      "type": "string",
      "maxLength": 4000,
      "title": "Quote"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "text",
     "version_id",
     "char_start",
     "char_end",
     "quote"
    ],
    "title": "SummaryItem"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
